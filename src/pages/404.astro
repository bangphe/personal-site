---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="flex min-h-[60vh] flex-col items-start justify-center">
    <p class="border-2 border-ink bg-pink px-3 py-1 font-mono text-sm font-bold text-ink shadow-hard-sm">404</p>
    <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">
      This page doesn&rsquo;t exist
    </h1>
    <p class="mt-4 text-lg text-muted">The link may be broken, or the page may have moved.</p>
    <a href="/" class="press mt-8 inline-flex border-2 border-ink bg-green px-6 py-3 text-base font-bold text-ink shadow-hard">
      Back home
    </a>
  </section>
</Base>
