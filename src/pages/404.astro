---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="flex min-h-[60vh] flex-col items-center justify-center text-center">
    <p class="font-mono text-sm text-accent-600 dark:text-accent-400">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
      This page doesn&rsquo;t exist
    </h1>
    <p class="mt-3 text-zinc-600 dark:text-zinc-400">
      The link may be broken, or the page may have moved.
    </p>
    <a href="/" class="mt-8 rounded-full bg-accent-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-accent-700">
      Back home
    </a>
  </section>
</Base>
