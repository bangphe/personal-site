---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---
<Base title="Contact" description={`Get in touch with ${site.name}.`}>
  <PageHeader eyebrow="Say hello" title="Get in touch" />

  <div class="max-w-prose">
    <p class="text-base leading-relaxed text-muted sm:text-lg">
      I&rsquo;m open to backend and full-stack work. The fastest way to reach me
      is email &mdash; I read everything.
    </p>

    <a
      href={`mailto:${site.email}`}
      class="press mt-8 inline-flex max-w-full items-center gap-2.5 border-2 border-ink bg-green px-4 py-3 text-sm font-bold text-ink shadow-hard sm:px-6 sm:py-3.5 sm:text-base"
    >
      <Icon name="mail" class="h-5 w-5" />
      <span class="min-w-0 break-all">{site.email}</span>
    </a>

    <p class="mt-10 font-bold text-ink">Elsewhere</p>
    <ul class="mt-4 flex items-center gap-3">
      {site.socials.map((s) => (
        <li>
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.label}
            title={s.label}
            class:list={['press grid h-12 w-12 place-items-center rounded-full border-2 border-ink text-ink shadow-hard', s.color]}
          >
            <Icon name={s.icon} class="h-5 w-5" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
