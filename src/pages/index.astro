---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import { getMediumPosts } from '../lib/medium';
import { site } from '../data/site';

const latest = await getMediumPosts(3);
---
<Base>
  <Hero />

  <section id="about" class="border-t-2 border-ink py-14 sm:py-20">
    <h2 class="text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">Where it starts</h2>

    <div class="mt-8 max-w-prose space-y-5 text-base leading-relaxed text-muted sm:text-lg">
      {/* TODO(verify): replace with your own bio. */}
      <p>
        I&rsquo;m a backend engineer based in {site.location}. I work mostly in
        Node.js, Go, PHP and .NET, designing and maintaining REST APIs and the
        services behind them.
      </p>
      <p>
        Most of my work has been on systems where correctness and throughput
        matter &mdash; banking applications handling high transaction volumes,
        data migrations, and the test coverage that keeps them safe to change.
      </p>
      <p>
        Outside of shipping features, I care about the parts that make a codebase
        survivable: clear boundaries, tests that fail for the right reasons, and
        documentation someone can actually follow.
      </p>
    </div>
  </section>

  {latest.length > 0 && (
    <section class="border-t-2 border-ink py-14 sm:py-20">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <h2 class="text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">
          Things I&rsquo;ve written
        </h2>
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 font-bold text-ink underline decoration-2 underline-offset-4"
        >
          All posts
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>

      <ul class="mt-8 grid list-none gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {latest.map((p, i) => <PostCard {...p} index={i} />)}
      </ul>
    </section>
  )}
</Base>
