---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import { getMediumPosts } from '../lib/medium';
import { site } from '../data/site';

const latest = await getMediumPosts(3);
---
<Base>
  <Hero />

  <section id="about" class="border-t-2 border-ink py-14 sm:py-20">
    <h2 class="text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">Where it starts</h2>

    <div class="mt-8 max-w-prose space-y-5 text-base leading-relaxed text-muted sm:text-lg">
      <p>
        I&rsquo;m a backend engineer in {site.location}, and I&rsquo;ve been
        building for the web since 2012. These days I&rsquo;m at Kano Solution,
        an IT company working on ERP and big-data systems, where I build the
        platforms our clients run their operations on.
      </p>
      <p>
        Most of that work is unglamorous in a good way: designing and maintaining
        RESTful APIs, tuning databases for performance and storage, writing stored
        procedures that generate the reports people actually read on Monday
        morning, and automating the parts nobody wants to do by hand.
      </p>
      <p>
        Alongside it I take on client work, usually where money moves &mdash; an
        Indonesian auction marketplace with escrow payments and a seller ledger, a
        property management platform in Saudi Arabia, a music learning site with a
        payment gateway. Laravel and Node.js mostly, and a healthy respect for
        idempotency. I write about what I learn over on Medium.
      </p>
    </div>
  </section>

  {latest.length > 0 && (
    <section class="border-t-2 border-ink py-14 sm:py-20">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <h2 class="text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">
          Things I&rsquo;ve written
        </h2>
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 font-bold text-ink underline decoration-2 underline-offset-4"
        >
          All posts
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>

      <ul class="mt-8 grid list-none gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {latest.map((p, i) => <PostCard {...p} index={i} />)}
      </ul>
    </section>
  )}
</Base>
