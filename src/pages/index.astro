---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import PostCard from '../components/PostCard.astro';
import ContactTerminal from '../components/ContactTerminal.astro';
import Icon from '../components/Icon.astro';
import { getMediumPosts } from '../lib/medium';

const latest = await getMediumPosts(3);
---
<Base>
  <Hero />

  <section id="about" class="border-t-2 border-ink py-14 sm:py-20">
    <h2 class="text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">What I do</h2>

    <!-- hyphens-auto keeps justified text from opening rivers of whitespace
         in a narrow measure. -->
    <div class="mt-8 max-w-prose space-y-5 hyphens-auto text-justify text-base leading-relaxed text-muted sm:text-lg">
      <p>
        I build and maintain the systems businesses run on &mdash; marketplaces,
        property platforms, ERP, and the payment flows behind them. I&rsquo;ve
        been working on the web since 2012, mostly in PHP and Node.js.
      </p>
      <p>
        Much of my work involves payments and transactions, where correctness
        matters most. I&rsquo;ve built escrow flows on Xendit, seller wallets
        with automated payouts, and payment integrations with Midtrans and
        PayFort. Alongside that, I design and maintain REST APIs, tune databases
        for performance, and handle the integrations that hold these systems
        together.
      </p>
      <p>
        If you&rsquo;re building something where transactions have to settle
        correctly and keep running long after launch, that&rsquo;s the work I do
        best.
      </p>
    </div>
  </section>

  {latest.length > 0 && (
    <section class="border-t-2 border-ink py-14 sm:py-20">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <h2 class="text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">
          Things I&rsquo;ve written
        </h2>
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 font-bold text-ink underline decoration-2 underline-offset-4"
        >
          All posts
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>

      <ul class="mt-8 grid list-none gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {latest.map((p, i) => <PostCard {...p} index={i} />)}
      </ul>
    </section>
  )}

  <ContactTerminal />
</Base>
