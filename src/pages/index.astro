---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import { getMediumPosts } from '../lib/medium';
import { site } from '../data/site';

const latest = await getMediumPosts(3);
---
<Base>
  <Hero />

  <section id="about" class="border-t-2 border-ink py-14 sm:py-20">
    <h2 class="text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">Where it starts</h2>

    <div class="mt-8 max-w-prose space-y-5 text-base leading-relaxed text-muted sm:text-lg">
      <p>
        I&rsquo;m a backend engineer in {site.location}, and I&rsquo;ve been doing
        this for about nine years. Right now I&rsquo;m at Kano Solution, an IT
        company building ERP and big-data systems, where I work across the stack
        on the platforms our clients run their operations on.
      </p>
      <p>
        Most of that work is unglamorous in a good way: designing and maintaining
        RESTful APIs, tuning databases for performance and storage, writing stored
        procedures that generate the reports people actually read on Monday
        morning, and automating the parts nobody wants to do by hand. Mostly PHP
        and .NET, with Go for scripting and automation.
      </p>
      <p>
        Before that I spent three years at EACIIT, a big-data consultancy in
        Surabaya with clients in eleven countries, translating client requirements
        into interfaces. I still write about what I learn &mdash; Laravel, OpenAI,
        payment gateways, TypeScript &mdash; over on Medium.
      </p>
    </div>
  </section>

  {latest.length > 0 && (
    <section class="border-t-2 border-ink py-14 sm:py-20">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <h2 class="text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">
          Things I&rsquo;ve written
        </h2>
        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 font-bold text-ink underline decoration-2 underline-offset-4"
        >
          All posts
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>

      <ul class="mt-8 grid list-none gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {latest.map((p, i) => <PostCard {...p} index={i} />)}
      </ul>
    </section>
  )}
</Base>
