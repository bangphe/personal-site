---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const experience = (await getCollection('experience')).sort(
  (a, b) => a.data.order - b.data.order,
);
const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const personal = projects.filter((p) => p.data.type === 'personal');
const client = projects.filter((p) => p.data.type === 'client');
---
<Base>
  <Hero />

  <Section id="about" title="About">
    <div class="space-y-4 text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
      {/* TODO(verify): replace with your own 2-3 paragraph bio. */}
      <p>
        I&rsquo;m a backend engineer based in {site.location}. I work mostly in
        Node.js, Go, PHP and .NET, designing and maintaining REST APIs and the
        services behind them.
      </p>
      <p>
        Most of my work has been on systems where correctness and throughput
        matter &mdash; banking applications handling high transaction volumes,
        data migrations, and the test coverage that keeps them safe to change.
      </p>
    </div>
  </Section>

  <Section id="experience" title="Experience" subtitle="Where I’ve worked">
    <ol class="list-none">
      {experience.map((e) => <ExperienceItem {...e.data} />)}
    </ol>
  </Section>

  <Section id="projects" title="Projects" subtitle="Things I’ve built">
    {client.length > 0 && (
      <>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wide text-zinc-500 dark:text-zinc-500">
          Client Projects
        </h3>
        <ul class="grid list-none gap-4 sm:grid-cols-2">
          {client.map((p) => <ProjectCard {...p.data} />)}
        </ul>
      </>
    )}

    {personal.length > 0 && (
      <>
        <h3 class="mb-4 mt-10 text-sm font-semibold uppercase tracking-wide text-zinc-500 dark:text-zinc-500">
          Personal Projects
        </h3>
        <ul class="grid list-none gap-4 sm:grid-cols-2">
          {personal.map((p) => <ProjectCard {...p.data} />)}
        </ul>
      </>
    )}
  </Section>

  <Section id="contact" title="Get in touch">
    <p class="text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
      I&rsquo;m open to backend and full-stack work. The fastest way to reach me
      is email &mdash; I read everything.
    </p>
    <a
      href={`mailto:${site.email}`}
      class="mt-6 inline-flex items-center gap-2 rounded-full bg-accent-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-accent-700"
    >
      <Icon name="mail" class="h-4 w-4" />
      {site.email}
    </a>
  </Section>
</Base>
