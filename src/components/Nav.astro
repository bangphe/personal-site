---
import { site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="border-b-2 border-ink bg-paper">
  <nav aria-label="Main" class="mx-auto flex max-w-5xl items-center gap-3 px-5 py-4 sm:px-8">
    <a
      href="/"
      aria-label={`${site.name} — home`}
      class="press shrink-0 border-2 border-ink bg-blue px-3 py-1.5 text-xs font-extrabold tracking-tight text-ink shadow-hard-sm sm:text-sm"
    >{site.name}</a>

    <!-- Scrolls rather than widening the page when four labels don't fit. -->
    <ul class="flex min-w-0 flex-1 items-center justify-end gap-1 overflow-x-auto [scrollbar-width:none] sm:gap-6 [&::-webkit-scrollbar]:hidden">
      {site.nav.map((l) => {
        const active = path === l.href;
        return (
          <li class="shrink-0">
            <a
              href={l.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'block px-1 py-1 text-sm transition-colors sm:text-base',
                active ? 'font-extrabold text-ink underline decoration-2 underline-offset-4' : 'font-medium text-muted hover:text-ink',
              ]}
            >{l.label}</a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>
