---
import { site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="border-b-2 border-ink bg-paper">
  <nav aria-label="Main" class="mx-auto flex max-w-5xl flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:px-8">
    <a
      href="/"
      aria-label={`${site.name} — home`}
      class="press shrink-0 self-start border-2 border-ink bg-blue px-3 py-1.5 text-xs font-extrabold tracking-tight text-ink shadow-hard-sm sm:text-sm"
    >{site.name}</a>

    <!-- Below sm the header stacks so all four labels stay visible; a
         right-aligned scroller would hide the first ones off-screen. Wide
         enough and it returns to one row. Still scrolls as a last resort. -->
    <ul class="-m-1.5 flex min-w-0 items-center gap-1 overflow-x-auto p-1.5 [scrollbar-width:none] sm:flex-1 sm:justify-end sm:gap-2 [&::-webkit-scrollbar]:hidden">
      {site.nav.map((l) => {
        const active = path === l.href;
        return (
          <li class="shrink-0">
            <a
              href={l.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                // The border is always 2px so hover and active cost no layout
                // shift. Its colour lives in one branch only: two competing
                // border-colour utilities resolve by CSS source order, not by
                // the order they appear in the class list.
                'block rounded-lg border-2 px-3 py-1.5 text-sm font-bold transition-all',
                active
                  ? 'border-ink text-ink shadow-pop'
                  : 'border-transparent text-muted hover:border-ink hover:text-ink hover:shadow-pop',
              ]}
            >{l.label}</a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>
