---
import { site } from '../data/site';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t-2 border-ink py-12">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-6 px-5 sm:px-8">
    <p class="text-center text-sm font-bold text-ink">
      &copy; {year} {site.name}. All rights reserved.
    </p>
    <ul class="flex items-center gap-4">
      {site.socials.map((s) => (
        <li>
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.label}
            title={s.label}
            class:list={[
              'press grid h-12 w-12 place-items-center rounded-full border-2 border-ink text-ink shadow-hard',
              s.color,
            ]}
          >
            <Icon name={s.icon} class="h-5 w-5" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
