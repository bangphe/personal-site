---
/**
 * Dark code card standing in for a portrait. JSON rather than a single
 * language, so the stack reads as the whole list and not as one speciality.
 * Palette is Monokai; window dots match the contact terminal.
 */
import { site } from '../data/site';

const file = 'rizky-purnawan.json';
---
<div class="w-full min-w-0 border-2 border-ink shadow-hard-lg">
  <div class="relative flex items-center gap-2 border-b border-white/10 bg-code-bg px-3 py-2">
    <span class="flex gap-1.5" aria-hidden="true">
      <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
    </span>
    <span class="pointer-events-none absolute inset-x-0 text-center font-mono text-xs text-code-dim">
      {file}
    </span>
  </div>

  <div class="overflow-hidden bg-code-bg px-4 py-4">
    <pre class="font-mono text-[11px] leading-relaxed text-code-fg sm:text-xs"><code><span class="text-code-dim">{'{'}</span>
  <span class="text-code-fg">"role"</span><span class="text-code-dim">:</span>       <span class="text-code-string">"{site.role}"</span><span class="text-code-dim">,</span>
  <span class="text-code-fg">"location"</span><span class="text-code-dim">:</span>   <span class="text-code-string">"{site.location}"</span><span class="text-code-dim">,</span>
  <span class="text-code-fg">"since"</span><span class="text-code-dim">:</span>      <span class="text-code-number">2012</span><span class="text-code-dim">,</span>
  <span class="text-code-fg">"stack"</span><span class="text-code-dim">:</span>      <span class="text-code-dim">[</span><span class="text-code-string">"PHP"</span><span class="text-code-dim">,</span> <span class="text-code-string">"Node.js"</span><span class="text-code-dim">,</span> <span class="text-code-string">".NET"</span><span class="text-code-dim">,</span> <span class="text-code-string">"Go"</span><span class="text-code-dim">,</span> <span class="text-code-string">"Vue"</span><span class="text-code-dim">],</span>
  <span class="text-code-fg">"focus"</span><span class="text-code-dim">:</span>      <span class="text-code-dim">[</span><span class="text-code-string">"APIs"</span><span class="text-code-dim">,</span> <span class="text-code-string">"payments"</span><span class="text-code-dim">,</span> <span class="text-code-string">"platforms"</span><span class="text-code-dim">],</span>
  <span class="text-code-fg">"open_to"</span><span class="text-code-dim">:</span>    <span class="text-code-string">"freelance"</span><span class="text-code-dim">,</span>
  <span class="text-code-fg">"available"</span><span class="text-code-dim">:</span>  <span class="text-code-number">true</span>
<span class="text-code-dim">{'}'}</span></code></pre>
  </div>
</div>
