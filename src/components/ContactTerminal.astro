---
import { site } from '../data/site';

const github = site.socials.find((s) => s.label === 'GitHub');
const linkedin = site.socials.find((s) => s.label === 'LinkedIn');
const prompt = `${site.firstName.toLowerCase()}@server`;

const githubDisplay = github?.url.replace(/^https?:\/\//, '') ?? '';
const linkedinDisplay = linkedin?.url.replace(/^https?:\/\/(www\.|id\.)?linkedin\.com\//, '') ?? '';
const accessKey = import.meta.env.WEB3FORMS_ACCESS_KEY as string | undefined;
---
<section id="contact" class="border-t-2 border-ink py-14 sm:py-20">
  <h2 class="text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">Contact</h2>

  <div class="mt-8 w-full min-w-0 border-2 border-ink shadow-hard-lg">
    <div class="relative flex items-center gap-2 border-b border-white/10 bg-code-bg px-3 py-2.5">
      <span class="flex gap-1.5" aria-hidden="true">
        <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
      </span>
      <span class="pointer-events-none absolute inset-x-0 text-center font-mono text-[10px] font-semibold tracking-[0.2em] text-code-dim sm:text-xs">
        contact.sh
      </span>
    </div>

    <div class="grid bg-code-bg md:grid-cols-2">
      <div class="min-w-0 overflow-x-auto border-b border-white/10 px-5 py-6 [scrollbar-width:thin] md:border-b-0 md:border-r md:px-6 md:py-8">
        <pre class="font-mono text-[12px] leading-7 text-code-fg sm:text-sm"><code><span class="text-code-prompt">{prompt}</span><span class="text-code-dim">:~$ </span><span class="text-code-fg">./check-availability</span>

<span class="text-code-ok">[OK] Available for freelance and collaborations.</span>

<span class="text-code-prompt">{prompt}</span><span class="text-code-dim">:~$ </span><span class="text-code-fg">initiate-contact --method all</span>

  <span class="text-code-dim">Email     -&gt;</span>  <a href={`mailto:${site.email}`} class="text-code-fg underline decoration-white/20 underline-offset-4 hover:decoration-code-prompt">{site.email}</a>
  <span class="text-code-dim">LinkedIn  -&gt;</span>  {linkedin ? <a href={linkedin.url} target="_blank" rel="noopener noreferrer" class="text-code-fg underline decoration-white/20 underline-offset-4 hover:decoration-code-prompt">{linkedinDisplay}</a> : null}
  <span class="text-code-dim">GitHub    -&gt;</span>  {github ? <a href={github.url} target="_blank" rel="noopener noreferrer" class="text-code-fg underline decoration-white/20 underline-offset-4 hover:decoration-code-prompt">{githubDisplay}</a> : null}

<span class="text-code-prompt">{prompt}</span><span class="text-code-dim">:~$ </span><span class="caret" aria-hidden="true"></span></code></pre>
      </div>

      <form
        id="contact-form"
        class="flex min-w-0 flex-col gap-5 px-5 py-6 md:px-6 md:py-8"
        action="https://api.web3forms.com/submit"
        method="POST"
      >
        <input type="hidden" name="access_key" value={accessKey ?? ''} />
        <input type="hidden" name="subject" value={`Message from ${site.name}'s site`} />
        <input type="hidden" name="from_name" value={site.name} />
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

        <p id="contact-status" class="hidden font-mono text-sm" role="status"></p>

        <div class="grid gap-5 sm:grid-cols-2">
          <label class="block min-w-0">
            <span class="font-mono text-[10px] font-semibold tracking-[0.18em] text-code-dim">NAME</span>
            <input
              type="text"
              name="name"
              required
              autocomplete="name"
              placeholder="Your Name"
              class="mt-2 w-full rounded-lg border border-white/15 bg-[#1b1c18] px-3 py-2.5 font-sans text-sm text-code-fg placeholder:text-code-dim/70"
            />
          </label>
          <label class="block min-w-0">
            <span class="font-mono text-[10px] font-semibold tracking-[0.18em] text-code-dim">EMAIL</span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder="email@example.com"
              class="mt-2 w-full rounded-lg border border-white/15 bg-[#1b1c18] px-3 py-2.5 font-sans text-sm text-code-fg placeholder:text-code-dim/70"
            />
          </label>
        </div>

        <label class="block min-w-0">
          <span class="font-mono text-[10px] font-semibold tracking-[0.18em] text-code-dim">MESSAGE</span>
          <textarea
            name="message"
            required
            rows="5"
            placeholder="Drop your message here..."
            class="mt-2 w-full resize-y rounded-lg border border-white/15 bg-[#1b1c18] px-3 py-2.5 font-sans text-sm text-code-fg placeholder:text-code-dim/70"
          ></textarea>
        </label>

        <button
          type="submit"
          class="mt-auto inline-flex w-full items-center justify-center gap-2 rounded-lg border border-white/20 bg-[#1b1c18] px-4 py-3 font-mono text-sm font-medium text-code-fg transition-colors hover:border-code-prompt hover:text-code-prompt disabled:cursor-wait disabled:opacity-60"
        >
          Send Message
          <span aria-hidden="true">→</span>
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  .caret {
    display: inline-block;
    width: 0.55ch;
    height: 1em;
    margin-bottom: -0.15em;
    vertical-align: text-bottom;
    background: var(--color-code-fg);
    animation: blink 1.1s step-end infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .caret { animation: none; }
  }

  @keyframes blink {
    50% { opacity: 0; }
  }
</style>

<script>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('contact-status');
  if (!(form instanceof HTMLFormElement) || !status) {
    // Homepage without the form — nothing to bind.
  } else {
    const submit = form.querySelector('button[type="submit"]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.className = 'font-mono text-sm text-code-dim';
      status.textContent = 'Sending…';
      if (submit instanceof HTMLButtonElement) submit.disabled = true;

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: new FormData(form),
        });
        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error('Send failed');
        }

        form.reset();
        status.className = 'font-mono text-sm text-code-ok';
        status.textContent = '[OK] Message sent. I will reply by email.';
      } catch {
        status.className = 'font-mono text-sm text-[#f92672]';
        status.textContent = '[ERR] Could not send. Email me directly instead.';
      } finally {
        if (submit instanceof HTMLButtonElement) submit.disabled = false;
      }
    });
  }
</script>
