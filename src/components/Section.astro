---
interface Props { id: string; title: string; subtitle?: string }
const { id, title, subtitle } = Astro.props;
---
<section id={id} class="border-t border-zinc-200 py-14 dark:border-zinc-800">
  <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">{title}</h2>
  {subtitle && <p class="mt-1.5 text-sm text-zinc-500 dark:text-zinc-500">{subtitle}</p>}
  <div class="mt-8">
    <slot />
  </div>
</section>
