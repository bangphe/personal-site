// Outline icons need stroke rendering; the brand/solid glyphs are filled paths.
const outline = ['external', 'folder', 'briefcase', 'arrow'].includes(name);
---
<svg
  class={className}
  viewBox="0 0 24 24"
  fill={outline ? 'none' : 'currentColor'}
  stroke={outline ? 'currentColor' : undefined}
  stroke-width={outline ? 1.7 : undefined}
  stroke-linecap={outline ? 'round' : undefined}
  stroke-linejoin={outline ? 'round' : undefined}
  aria-hidden="true"
>
  <path d={paths[name]} />
</svg>
