---
import { site } from '../data/site';
import Icon from './Icon.astro';
---
<section class="grid items-center gap-12 py-14 sm:py-20 md:grid-cols-2 md:gap-10">
  <div>
    <p class="text-lg font-medium text-muted">Hey, I&rsquo;m {site.firstName}</p>

    <h1 class="mt-2 text-5xl font-extrabold leading-[1.05] tracking-tight text-ink sm:text-6xl">
      {site.headline}
    </h1>

    <p class="mt-6 max-w-md text-base leading-relaxed text-muted sm:text-lg">
      {site.description}
    </p>

    <a
      href={`mailto:${site.email}`}
      class="press mt-8 inline-flex items-center gap-2 border-2 border-ink bg-green px-6 py-3 text-base font-bold text-ink shadow-hard"
    >
      {site.ctaLabel}
    </a>

    <ul class="mt-10 flex items-center gap-3">
      {site.socials.map((s) => (
        <li>
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.label}
            title={s.label}
            class:list={[
              'press grid h-10 w-10 place-items-center rounded-full border-2 border-ink text-ink shadow-hard-sm',
              s.color,
            ]}
          >
            <Icon name={s.icon} class="h-4 w-4" />
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="relative mx-auto w-full max-w-xs md:max-w-sm">
    <img
      src={site.avatar}
      alt={`Portrait of ${site.name}`}
      width="384"
      height="384"
      loading="eager"
      decoding="async"
      class="w-full rounded-2xl border-2 border-ink bg-blue object-cover shadow-hard-lg"
    />

    <!-- Decorative badges, echoing the reference's floating chips. -->
    <span
      aria-hidden="true"
      class="absolute -left-4 -top-4 grid h-14 w-14 place-items-center rounded-xl border-2 border-ink bg-pink font-mono text-[10px] font-bold leading-tight text-ink shadow-hard-sm"
    >&lt;/&gt;</span>
    <span
      aria-hidden="true"
      class="absolute -bottom-4 -right-4 grid h-14 w-14 place-items-center rounded-full border-2 border-ink bg-cream text-lg font-extrabold text-ink shadow-hard-sm"
    >{'{ }'}</span>
  </div>
</section>
