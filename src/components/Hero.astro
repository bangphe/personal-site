---
import { site } from '../data/site';
import CodeCard from './CodeCard.astro';
---
<section class="grid items-center gap-10 py-14 sm:py-20 md:grid-cols-2 md:gap-12">
  <div class="min-w-0">
    <h1 class="text-3xl font-extrabold leading-[1.15] tracking-tight text-ink sm:text-4xl">
      {site.role}
    </h1>

    <p class="mt-5 max-w-md text-base leading-relaxed text-muted sm:text-lg">
      {site.intro}
    </p>

    <a
      href={`mailto:${site.email}`}
      class="press mt-8 inline-flex items-center gap-2 border-2 border-ink bg-green px-6 py-3 text-base font-bold text-ink shadow-hard"
    >
      {site.ctaLabel}
    </a>
  </div>

  <div class="w-full min-w-0">
    <CodeCard />
  </div>
</section>
