---
import { site } from '../data/site';
---
<section class="flex flex-col items-center pt-16 pb-14 text-center sm:pt-24">
  <img
    src={site.avatar}
    alt={`Portrait of ${site.name}`}
    width="128"
    height="128"
    loading="eager"
    decoding="async"
    class="h-28 w-28 rounded-full object-cover ring-1 ring-zinc-200 dark:ring-zinc-800"
  />

  <h1 class="mt-7 text-4xl font-bold tracking-tight text-zinc-900 sm:text-5xl dark:text-zinc-50">
    Hey, I&rsquo;m {site.firstName}
  </h1>

  <p class="mt-3 text-lg font-medium text-accent-600 dark:text-accent-400">
    {site.tagline}
  </p>

  <p class="mt-4 text-balance text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
    {site.description}
  </p>

  <a
    href={`mailto:${site.email}`}
    class="mt-8 inline-flex items-center gap-2 rounded-full bg-accent-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-accent-700"
  >
    {site.ctaLabel}
  </a>
</section>
