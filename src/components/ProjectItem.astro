---
import Icon from './Icon.astro';

interface Props {
  name: string; description: string; platform: string;
  role?: string; period?: string; highlights?: string[];
  stack: string[]; links: { label: string; url: string }[]; index?: number;
}
const {
  name, description, platform, role, period,
  highlights = [], stack, links, index = 0,
} = Astro.props;

const fills = ['bg-cream', 'bg-blue', 'bg-lilac', 'bg-green'];
const fill = fills[index % fills.length];
---
<li class="flex gap-4 sm:gap-5">
  <div class="flex flex-col items-center">
    <span
      aria-hidden="true"
      class:list={['grid h-10 w-10 shrink-0 place-items-center rounded-full border-2 border-ink text-sm font-extrabold text-ink shadow-hard-sm', fill]}
    >{name.charAt(0)}</span>
    <span class="mt-2 w-0.5 flex-1 bg-ink/20" aria-hidden="true"></span>
  </div>

  <div class="min-w-0 max-w-prose flex-1 pb-10">
    <div class="flex flex-col gap-x-3 sm:flex-row sm:items-baseline sm:justify-between">
      <h3 class="font-extrabold text-ink">
        {name}
        {role && <span class="font-medium text-muted"> &mdash; {role}</span>}
      </h3>
      {period && <p class="shrink-0 text-xs font-semibold text-muted">{period}</p>}
    </div>

    <p class="mt-1 text-sm text-muted">{platform}</p>

    <p class="mt-2.5 leading-relaxed text-muted">{description}</p>

    {highlights.length > 0 && (
      <ul class="mt-3 space-y-1.5">
        {highlights.map((h) => (
          <li class="flex gap-2.5 text-sm leading-relaxed text-muted">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ink" aria-hidden="true"></span>
            <span>{h}</span>
          </li>
        ))}
      </ul>
    )}

    {stack.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {stack.map((t) => (
          <li class="border-2 border-ink bg-white px-2 py-0.5 text-xs font-semibold text-ink">{t}</li>
        ))}
      </ul>
    )}

    {links.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-4">
        {links.map((l) => (
          <a
            href={l.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm font-bold text-ink underline decoration-2 underline-offset-4"
          >
            {l.label}
            <Icon name="external" class="h-3.5 w-3.5" />
          </a>
        ))}
      </div>
    )}
  </div>
</li>
