---
import TechTag from './TechTag.astro';
import CompanyLogo from './CompanyLogo.astro';

interface Props {
  company: string; role: string; start: string; end: string | null;
  location: string; summary: string; highlights: string[]; stack: string[];
  logo?: string; index?: number;
}
const { company, role, start, end, location, summary, highlights, stack, logo, index = 0 } = Astro.props;

/** "2021-03" -> "Mar 2021". Passes through TODO(verify) and any non-date string. */
function fmt(value: string | null): string {
  if (value === null) return 'Present';
  const m = /^(\d{4})-(\d{2})$/.exec(value);
  if (!m) return value;
  return new Date(Number(m[1]), Number(m[2]) - 1)
    .toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}
---
<li class="flex gap-4 sm:gap-5">
  <div class="flex flex-col items-center">
    <CompanyLogo name={company} logo={logo} index={index} />
    <span class="mt-2 w-0.5 flex-1 bg-ink/20" aria-hidden="true"></span>
  </div>

  <div class="min-w-0 max-w-prose flex-1 pb-12">
    <div class="flex flex-col gap-x-3 sm:flex-row sm:items-baseline sm:justify-between">
      <h2 class="text-lg font-extrabold text-ink">{role}</h2>
      <p class="shrink-0 text-xs font-semibold text-muted">{fmt(start)} &ndash; {fmt(end)}</p>
    </div>

    <p class="mt-0.5 font-semibold text-ink">{company}</p>
    <p class="text-xs text-muted">{location}</p>

    <p class="mt-3 leading-relaxed text-muted">{summary}</p>

    <ul class="mt-3 space-y-1.5">
      {highlights.map((h) => (
        <li class="flex gap-2.5 text-sm leading-relaxed text-muted">
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ink" aria-hidden="true"></span>
          <span>{h}</span>
        </li>
      ))}
    </ul>

    {stack.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {stack.map((t) => <TechTag label={t} />)}
      </ul>
    )}
  </div>
</li>
