---
import TechTag from './TechTag.astro';
import CompanyLogo from './CompanyLogo.astro';

interface Engagement {
  name: string;
  role?: string;
  description?: string;
  responsibilities: string[];
  tools: string[];
}

interface Props {
  company: string; role: string; start: string; end: string | null;
  location: string; summary: string; highlights: string[]; stack: string[];
  projects?: Engagement[];
  employmentType?: string; workMode?: string;
  logo?: string; index?: number;
}
const {
  company, role, start, end, location, summary, highlights, stack,
  projects = [], employmentType, workMode, logo, index = 0,
} = Astro.props;

/** "2020-04" -> "Apr 2020". Passes through any non-date string unchanged. */
function fmt(value: string | null): string {
  if (value === null) return 'Present';
  const m = /^(\d{4})-(\d{2})$/.exec(value);
  if (!m) return value;
  return new Date(Number(m[1]), Number(m[2]) - 1)
    .toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}

const meta = [employmentType, workMode].filter(Boolean).join(' · ');
---
<li class="flex gap-4 sm:gap-5">
  <div class="flex flex-col items-center">
    <CompanyLogo name={company} logo={logo} index={index} />
    <span class="mt-2 w-0.5 flex-1 bg-ink/20" aria-hidden="true"></span>
  </div>

  <div class="min-w-0 max-w-prose flex-1 pb-12">
    <div class="flex flex-col gap-x-3 sm:flex-row sm:items-baseline sm:justify-between">
      <h2 class="text-lg font-extrabold text-ink">{role}</h2>
      <p class="shrink-0 text-xs font-semibold text-muted">{fmt(start)} &ndash; {fmt(end)}</p>
    </div>

    <p class="mt-0.5 font-semibold text-ink">{company}</p>
    <p class="text-xs text-muted">
      {location}{meta && <> &middot; {meta}</>}
    </p>

    <p class="mt-3 leading-relaxed text-muted">{summary}</p>

    {highlights.length > 0 && (
      <ul class="mt-3 space-y-1.5">
        {highlights.map((h) => (
          <li class="flex gap-2.5 text-sm leading-relaxed text-muted">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ink" aria-hidden="true"></span>
            <span>{h}</span>
          </li>
        ))}
      </ul>
    )}

    {projects.length > 0 && (
      <div class="mt-5 space-y-4">
        {projects.map((p) => (
          <details class="border-2 border-ink bg-white">
            <summary class="cursor-pointer list-none px-4 py-3 font-bold text-ink marker:hidden [&::-webkit-details-marker]:hidden">
              <span class="flex items-baseline justify-between gap-3">
                <span>
                  {p.name}
                  {p.role && <span class="font-medium text-muted"> &mdash; {p.role}</span>}
                </span>
                <span class="shrink-0 text-xs font-semibold text-muted">Details</span>
              </span>
            </summary>

            <div class="border-t-2 border-ink px-4 py-3">
              {p.description && (
                <p class="text-sm leading-relaxed text-muted">{p.description}</p>
              )}

              {p.responsibilities.length > 0 && (
                <ul class:list={['space-y-1.5', p.description && 'mt-3']}>
                  {p.responsibilities.map((r) => (
                    <li class="flex gap-2.5 text-sm leading-relaxed text-muted">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-ink" aria-hidden="true"></span>
                      <span>{r}</span>
                    </li>
                  ))}
                </ul>
              )}

              {p.tools.length > 0 && (
                <ul class="mt-4 flex flex-wrap gap-2">
                  {p.tools.map((t) => (
                    <li class="border-2 border-ink px-2 py-0.5 text-xs font-semibold text-ink">{t}</li>
                  ))}
                </ul>
              )}
            </div>
          </details>
        ))}
      </div>
    )}

    {stack.length > 0 && (
      <ul class="mt-5 flex flex-wrap gap-2">
        {stack.map((t) => <TechTag label={t} />)}
      </ul>
    )}
  </div>
</li>
