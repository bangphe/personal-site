---
import TechTag from './TechTag.astro';
import Icon from './Icon.astro';

interface Props {
  name: string; description: string; platform: string;
  stack: string[]; links: { label: string; url: string }[];
}
const { name, description, platform, stack, links } = Astro.props;
---
<li class="rounded-xl border border-zinc-200 p-5 transition-colors hover:border-zinc-300 dark:border-zinc-800 dark:hover:border-zinc-700">
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-semibold text-zinc-900 dark:text-zinc-100">{name}</h3>
    <span class="shrink-0 rounded-full bg-accent-50 px-2.5 py-0.5 text-xs font-medium text-accent-700 dark:bg-accent-500/10 dark:text-accent-400">
      {platform}
    </span>
  </div>

  <p class="mt-2.5 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{description}</p>

  {stack.length > 0 && (
    <ul class="mt-4 flex flex-wrap gap-1.5">
      {stack.map((t) => <TechTag label={t} />)}
    </ul>
  )}

  {links.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-4">
      {links.map((l) => (
        <a
          href={l.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm font-medium text-accent-600 hover:underline dark:text-accent-400"
        >
          {l.label}
          <Icon name="external" class="h-3.5 w-3.5" />
        </a>
      ))}
    </div>
  )}
</li>
