---
import { Image } from 'astro:assets';

interface Props {
  title: string; url: string; date: Date;
  tags: string[]; excerpt: string; image?: string; index?: number;
}
const { title, url, date, tags, excerpt, image, index = 0 } = Astro.props;

const fills = ['bg-blue', 'bg-green', 'bg-cream', 'bg-lilac'];
const fill = fills[index % fills.length];

const formatted = date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'short', day: 'numeric',
});
---
<li class="h-full">
  <a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    class="press flex h-full flex-col border-2 border-ink bg-white shadow-hard"
  >
    <!-- Tinted panel doubles as the placeholder when Medium's CDN image
         is missing or fails to load. -->
    <div class:list={['aspect-[16/9] w-full overflow-hidden border-b-2 border-ink', fill]}>
      {image && (
        <Image
          src={image}
          alt=""
          width={640}
          height={360}
          loading={index === 0 ? 'eager' : 'lazy'}
          class="h-full w-full object-cover"
        />
      )}
    </div>

    <div class="flex flex-1 flex-col p-4">
      <time datetime={date.toISOString()} class="text-xs font-semibold text-muted">
        {formatted}
      </time>

      <h2 class="mt-1.5 text-lg font-extrabold leading-snug text-ink">{title}</h2>

      <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{excerpt}</p>

      {tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {tags.map((t) => (
            <li class="border-2 border-ink px-2 py-0.5 text-xs font-semibold text-ink">{t}</li>
          ))}
        </ul>
      )}
    </div>
  </a>
</li>
